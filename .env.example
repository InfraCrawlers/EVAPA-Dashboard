# Server Configuration
PORT=5000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS Configuration
# EC2 region for fetching instances
AWS_REGION=us-east-1

# AWS Credentials (optional - needed for EC2 instance listing)
# Get these from AWS IAM console: https://console.aws.amazon.com/iam/
# Requires EC2:DescribeInstances permission
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS API Gateway (DynamoDB)
AWS_API_ENDPOINT=https://7ayzyoa7fl.execute-api.us-east-1.amazonaws.com

# Cache Configuration (in seconds)
CACHE_TTL_FINDINGS=3600
CACHE_TTL_REPORTS=3600
CACHE_TTL_SYSTEMS=1800

# Environment
NODE_ENV=development
